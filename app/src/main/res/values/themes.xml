<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseTheme.CouchZap" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_black</item>
        <item name="android:colorBackground">@color/bg_black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:keepScreenOn">true</item>
        <item name="colorAccent">@color/accent_gold</item>
        <item name="buttonStyle">@style/Widget.CouchZap.FlatButton</item>
        <item name="android:buttonStyle">@style/Widget.CouchZap.FlatButton</item>
    </style>
    <style name="Theme.CouchZap" parent="BaseTheme.CouchZap" />
    <!-- Our selectors provide pressed/focus feedback. Native button Z animations
         must not leave shadows when a retained settings page is reattached. -->
    <style name="Widget.CouchZap.FlatButton" parent="Widget.AppCompat.Button">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
    </style>
</resources>
