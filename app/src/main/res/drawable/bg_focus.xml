<?xml version="1.0" encoding="utf-8"?>
<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_focused="true">
        <shape>
            <solid
                android:color="@color/item_focus" />
            <corners
                android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/item_focus_stroke" />
        </shape>
    </item>
    <item
        android:state_pressed="true">
        <shape>
            <solid
                android:color="@color/item_focus" />
            <corners
                android:radius="12dp" />
        </shape>
    </item>
    <item
        android:state_selected="true">
        <shape>
            <solid
                android:color="#203F6045" />
            <corners
                android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/accent_gold" />
        </shape>
    </item>
    <item>
        <shape>
            <solid
                android:color="@color/item_normal" />
            <corners
                android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/outline" />
        </shape>
    </item>
</selector>
