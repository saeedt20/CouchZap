<selector xmlns:android="http://schemas.android.com/apk/res/android">
<item android:state_focused="true"><shape><solid android:color="@color/cz_surface_focus"/><corners android:radius="10dp"/><stroke android:width="2dp" android:color="@color/cz_sage_bright"/></shape></item>
<item android:state_pressed="true"><shape><solid android:color="@color/cz_surface_focus"/><corners android:radius="10dp"/><stroke android:width="2dp" android:color="@color/cz_sage_bright"/></shape></item>
<item android:state_selected="true"><shape><solid android:color="@color/cz_surface_selected"/><corners android:radius="10dp"/></shape></item>
<item><shape><solid android:color="@color/cz_surface_content"/><corners android:radius="10dp"/></shape></item>
</selector>
