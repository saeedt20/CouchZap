<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/osd_container"
    android:layout_width="400dp"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:layout_margin="24dp"
    android:background="@drawable/bg_osd"
    android:orientation="vertical"
    android:padding="20dp"
    android:visibility="gone">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/iv_osd_logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_station"
            android:importantForAccessibility="no" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_osd_channel_name" android:textAlignment="viewStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_white"
                android:textSize="26sp" />
        </LinearLayout>
        <ImageButton
            android:id="@+id/btn_osd_favourite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_focus"
            android:padding="9dp"
            android:src="@drawable/ic_favourite"
            android:contentDescription="@string/favourite_add_action"
            app:tint="@color/selector_favourite_icon" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
            <TextView
                android:id="@+id/tv_osd_channel_number"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/text_gray"
                android:textSize="15sp" />
        <TextView
            android:id="@+id/tv_osd_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/text_gray" />
    </LinearLayout>
    <TextView
        android:id="@+id/tv_osd_stream_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_gray"
        android:textSize="15sp" />
    <LinearLayout
        android:id="@+id/osd_buffering_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">
        <ProgressBar
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:indeterminate="true" />
        <TextView android:id="@+id/localized_label_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/buffering"
            android:textColor="@color/accent_gold"
            android:textSize="15sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/tv_osd_programme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:textColor="@color/text_white"
        android:textSize="15sp"
        android:visibility="gone" />
    <ProgressBar
        android:id="@+id/programme_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="8dp"
        android:progressTint="@color/accent_gold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tv_osd_technical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_gray"
        android:textSize="15sp"
        android:visibility="gone" />
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/osd_touch_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <ImageButton
                android:id="@+id/btn_osd_channels"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_focus"
                android:contentDescription="@string/channels"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_menu_channels"
                app:tint="@color/selector_channel_text" />
            <ImageButton
                android:id="@+id/btn_osd_prev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_focus"
                android:contentDescription="@string/previous_channel"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_skip_prev"
                app:tint="@color/selector_channel_text" />
            <ImageButton
                android:id="@+id/btn_osd_play_pause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_focus"
                android:contentDescription="@string/pause"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_pause"
                app:tint="@color/selector_channel_text" />
            <ImageButton
                android:id="@+id/btn_osd_next"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_focus"
                android:contentDescription="@string/next_channel"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/selector_channel_text" />
            <ImageButton
                android:id="@+id/btn_osd_aspect"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_focus"
                android:contentDescription="@string/choose_aspect"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_aspect_ratio"
                app:tint="@color/selector_channel_text" />
            <ImageButton
                android:id="@+id/btn_osd_settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_focus"
                android:contentDescription="@string/settings"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_settings"
                app:tint="@color/selector_channel_text" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/tv_osd_action_label"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/channels"
            android:textColor="@color/text_white"
            android:textSize="15sp" />
        <TextView android:id="@+id/localized_label_15"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/details_hint"
            android:textColor="@color/text_gray"
            android:textSize="15sp" />
    </LinearLayout>
    <Button
        android:id="@+id/btn_osd_last_channel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_focus"
        android:text="@string/previous_watched"
        android:textAllCaps="false"
        android:textColor="@color/selector_channel_text"
        android:visibility="gone" />
</LinearLayout>
