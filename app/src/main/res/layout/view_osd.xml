<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/osd_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:layout_margin="24dp"
    android:background="@drawable/bg_osd"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Row 1: 3-digit channel number -->
        <TextView
            android:id="@+id/tv_osd_channel_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent_gold"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Channel name -->
        <TextView
            android:id="@+id/tv_osd_channel_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Stream details: 20:45 • H.264 • 1080p • FHD • 4.2 Mbps • AAC -->
    <TextView
        android:id="@+id/tv_osd_stream_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif"
        android:maxLines="1"
        android:textColor="@color/text_gray"
        android:textSize="14sp" />

    <!-- Buffering / Live row -->
    <LinearLayout
        android:id="@+id/osd_buffering_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/buffering"
            android:textColor="@color/accent_gold"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:scrollbars="none">
    <!-- Touch Action Bar for Smartphones / Tablets -->
    <LinearLayout
        android:id="@+id/osd_touch_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btn_osd_channels"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_focus"
            android:contentDescription="Channels"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_menu_channels" />

        <ImageButton
            android:id="@+id/btn_osd_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_focus"
            android:contentDescription="Previous channel"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_skip_prev" />

        <ImageButton
            android:id="@+id/btn_osd_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_focus"
            android:contentDescription="Play or Pause"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_play_pause" />

        <ImageButton
            android:id="@+id/btn_osd_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_focus"
            android:contentDescription="Next channel"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/btn_osd_aspect"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_focus"
            android:contentDescription="Aspect ratio"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_aspect_ratio" />

        <ImageButton
            android:id="@+id/btn_osd_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_focus"
            android:contentDescription="Settings"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    </HorizontalScrollView>
</LinearLayout>
