<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:keepScreenOn="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <!-- ExoPlayer Video Surface -->
    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/video_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
    </androidx.media3.ui.AspectRatioFrameLayout>

    <!-- Shutter View for smooth zapping crossfade -->
    <View
        android:id="@+id/v_shutter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/bg_black"
        android:visibility="gone" />

    <!-- Top-Right NEXT channel ghost hint -->
    <TextView
        android:id="@+id/tv_ghost_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_osd"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/accent_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Big Digit Entry Ghost Overlay -->
    <TextView
        android:id="@+id/tv_digit_ghost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_osd"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_white"
        android:textSize="52sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Toast / Message / Error Banner -->
    <TextView
        android:id="@+id/tv_toast_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_osd"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:visibility="gone" />

    <!-- Top-Left OSD -->
    <include
        android:id="@+id/view_osd"
        layout="@layout/view_osd" />

    <!-- Left-Side Channel List Overlay -->
    <include
        android:id="@+id/view_channel_list"
        layout="@layout/view_channel_list" />

    <!-- Settings Menu Overlay -->
    <ScrollView
        android:id="@+id/layout_settings"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_osd"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Settings"
                android:textColor="@color/accent_gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_settings_close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_focus"
                android:contentDescription="Close settings"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/ic_close" />
        </RelativeLayout>

        <Button
            android:id="@+id/btn_settings_reimport"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_focus"
            android:focusable="true"
            android:text="@string/settings_reimport"
            android:textColor="@color/selector_channel_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_settings_aspect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_focus"
            android:focusable="true"
            android:text="Aspect ratio: Fit"
            android:textColor="@color/selector_channel_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_settings_mode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_focus"
            android:focusable="true"
            android:text="Interface: Auto"
            android:textColor="@color/selector_channel_text" />

        <Button
            android:id="@+id/btn_settings_exit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_focus"
            android:focusable="true"
            android:text="@string/settings_exit"
            android:textColor="@color/selector_channel_text"
            android:textSize="16sp" />
    </LinearLayout>
    </ScrollView>

    <!-- Fallback File Browser Overlay -->
    <LinearLayout
        android:id="@+id/layout_file_browser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_black"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_file_browser_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="/storage"
            android:textColor="@color/accent_gold"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_file_browser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_quick_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_focus"
        android:contentDescription="Settings"
        android:src="@drawable/ic_settings"
        android:padding="12dp" />

    <!-- First Run Import Screen Overlay -->
    <include
        android:id="@+id/view_import"
        layout="@layout/view_import" />

</FrameLayout>
