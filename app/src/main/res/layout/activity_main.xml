<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">
    <androidx.media3.ui.AspectRatioFrameLayout
        android:id="@+id/video_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">
        <SurfaceView
            android:id="@+id/surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.media3.ui.AspectRatioFrameLayout>
    <androidx.media3.ui.SubtitleView
        android:id="@+id/subtitle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <View
        android:id="@+id/v_shutter"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/bg_black"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tv_ghost_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/bg_osd"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:textColor="@color/accent_gold"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tv_digit_ghost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_osd"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_white"
        android:textSize="52sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tv_toast_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_osd"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/text_white"
        android:textSize="20sp"
        android:visibility="gone" />
    <include
        android:id="@+id/view_osd"
        layout="@layout/view_osd" />
    <include
        android:id="@+id/view_channel_list"
        layout="@layout/view_channel_list" />
    <ScrollView
        android:id="@+id/layout_settings"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="left"
        android:background="@color/panel_background"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="@string/settings"
                    android:textColor="@color/text_white"
                    android:textSize="28sp"
                    android:fontFamily="sans-serif-medium" />
                <ImageButton
                    android:id="@+id/btn_settings_close"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_focus"
                    android:contentDescription="@string/close"
                    android:focusable="true"
                    android:padding="12dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/selector_channel_text" />
            </RelativeLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:text="@string/playback_section"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />
            <com.couchzap.iptv.ui.SettingRow
                android:id="@+id/btn_settings_aspect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/choose_aspect"
                    android:textSize="16sp"
                    android:textColor="@color/selector_channel_text" />
                <TextView
                    android:id="@+id/tv_settings_aspect_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="110dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:duplicateParentState="true"
                    android:text="@string/aspect_fit"
                    android:textSize="15sp"
                    android:textColor="@color/selector_channel_text" />
            </com.couchzap.iptv.ui.SettingRow>
            <Button
                android:id="@+id/btn_settings_tracks"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:focusable="true"
                android:text="@string/audio_subtitles"
                android:textAllCaps="false"
                android:textColor="@color/selector_channel_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp" />
            <com.couchzap.iptv.ui.SettingRow
                android:id="@+id/btn_settings_sleep"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/sleep_timer"
                    android:textSize="16sp"
                    android:textColor="@color/selector_channel_text" />
                <TextView
                    android:id="@+id/tv_settings_sleep_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="110dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:duplicateParentState="true"
                    android:text="@string/off"
                    android:textSize="15sp"
                    android:textColor="@color/selector_channel_text" />
            </com.couchzap.iptv.ui.SettingRow>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:text="@string/playlist_section"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btn_settings_reimport"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:focusable="true"
                android:text="@string/playlist_sources"
                android:textAllCaps="false"
                android:textColor="@color/selector_channel_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp" />
            <TextView
                android:id="@+id/tv_settings_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/playlist_not_added"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btn_settings_guide"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:focusable="true"
                android:text="@string/programme_guide"
                android:textAllCaps="false"
                android:textColor="@color/selector_channel_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:text="@string/app_section"
                android:textColor="@color/text_gray"
                android:textSize="13sp" />
            <com.couchzap.iptv.ui.SettingRow
                android:id="@+id/btn_settings_mode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="@string/interface_mode"
                    android:textSize="16sp"
                    android:textColor="@color/selector_channel_text" />
                <TextView
                    android:id="@+id/tv_settings_mode_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="110dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:duplicateParentState="true"
                    android:text="@string/automatic"
                    android:textSize="15sp"
                    android:textColor="@color/selector_channel_text" />
            </com.couchzap.iptv.ui.SettingRow>
            <Button
                android:id="@+id/btn_settings_update"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:focusable="true"
                android:text="@string/check_updates"
                android:textAllCaps="false"
                android:textColor="@color/selector_channel_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp" />
            <Button
                android:id="@+id/btn_settings_logs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:focusable="true"
                android:text="@string/diagnostic_log"
                android:textAllCaps="false"
                android:textColor="@color/selector_channel_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp" />
            <Button
                android:id="@+id/btn_settings_about"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:focusable="true"
                android:text="@string/about"
                android:textAllCaps="false"
                android:textColor="@color/selector_channel_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp" />
            <Button
                android:id="@+id/btn_settings_exit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_focus"
                android:focusable="true"
                android:text="@string/settings_exit"
                android:textAllCaps="false"
                android:textColor="@color/selector_channel_text"
                android:textSize="16sp"
                android:gravity="start|center_vertical"
                android:paddingStart="14dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/layout_file_browser"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_black"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_file_browser_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="/storage"
            android:textColor="@color/accent_gold"
            android:textSize="20sp"
            android:textStyle="bold" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_file_browser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="true" />
    </LinearLayout>
    <ImageButton
        android:id="@+id/btn_quick_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:background="@drawable/bg_focus"
        android:contentDescription="Settings"
        android:src="@drawable/ic_settings"
        android:padding="12dp" />
    <LinearLayout
        android:id="@+id/layout_playback_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_osd"
        android:padding="24dp"
        android:orientation="vertical"
        android:visibility="gone">
        <TextView
            android:id="@+id/tv_playback_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="400dp"
            android:text="@string/channel_unavailable"
            android:textSize="20sp"
            android:textColor="@color/text_white"
            android:layout_marginBottom="16dp" />
        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_focus"
            android:focusable="true"
            android:text="@string/retry"
            android:textAllCaps="false"
            android:textColor="@color/selector_channel_text"
            android:textSize="16sp" />
        <Button
            android:id="@+id/btn_error_next"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_focus"
            android:focusable="true"
            android:text="@string/next_channel"
            android:textAllCaps="false"
            android:textColor="@color/selector_channel_text"
            android:textSize="16sp" />
    </LinearLayout>
    <include
        android:id="@+id/view_import"
        layout="@layout/view_import" />
</FrameLayout>
