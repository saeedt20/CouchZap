<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/import_container" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/cz_canvas" android:fillViewport="true" android:scrollbars="vertical" android:clickable="true">
    <LinearLayout android:id="@+id/import_content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp" android:clipChildren="false" android:clipToPadding="false">
        <LinearLayout android:id="@+id/import_header" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:layout_marginBottom="28dp" android:clipChildren="false" android:clipToPadding="false">
            <FrameLayout android:layout_width="40dp" android:layout_height="40dp" android:importantForAccessibility="noHideDescendants">
                <ImageView android:id="@+id/localized_label_1" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_brand" />
                <ImageView android:id="@+id/intro_bolt" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/ic_brand_flash" android:alpha="0" />
            </FrameLayout>
            <TextView android:id="@+id/localized_label_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:text="@string/app_name" android:textAlignment="viewStart" android:gravity="start|center_vertical" android:textColor="@color/cz_text_primary" />
            <Button android:id="@+id/btn_import_language" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="56dp" android:minWidth="0dp"
                android:drawableStart="@drawable/ic_public" android:drawablePadding="8dp" android:drawableEnd="@drawable/ic_chevron" android:text="English"
                android:textAllCaps="false" android:paddingStart="12dp" android:paddingEnd="12dp" android:focusable="true" android:focusableInTouchMode="true"
                android:background="@drawable/bg_focus" android:textColor="@color/cz_text_primary" />
        </LinearLayout>
        <LinearLayout android:id="@+id/import_columns" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="center_vertical" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
            <LinearLayout android:id="@+id/import_intro" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:id="@+id/import_eyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/welcome_eyebrow" android:textColor="@color/cz_sage" />
                <TextView android:id="@+id/tv_import_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/import_title" android:gravity="start" />
                <TextView android:id="@+id/tv_import_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/import_hint" android:gravity="start" />
            </LinearLayout>
            <LinearLayout android:id="@+id/import_actions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
                <com.couchzap.iptv.ui.SettingRow android:id="@+id/btn_import" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="88dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp" android:src="@drawable/ic_import" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:tag="cz_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_import_playlist" />
                        <TextView android:id="@+id/localized_label_3" android:tag="cz_supporting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/playlist_formats" android:textDirection="ltr" />
                    </LinearLayout>
                </com.couchzap.iptv.ui.SettingRow>
                <com.couchzap.iptv.ui.SettingRow android:id="@+id/btn_public" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="88dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginEnd="16dp" android:src="@drawable/ic_public" android:importantForAccessibility="no" />
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                        <TextView android:tag="cz_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/public_channels" />
                        <TextView android:id="@+id/localized_label_5" android:tag="cz_supporting" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/public_credit" android:textDirection="ltr" />
                    </LinearLayout>
                </com.couchzap.iptv.ui.SettingRow>
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/tv_import_progress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textColor="@color/cz_sage" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/tv_import_remote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/remote_hint" />
    </LinearLayout>
</ScrollView>
